# Copy to .env (ignored). Real values are shared privately, never committed.

# The Graph
GRAPH_API_KEY=            # gateway query key (thegraph.com/studio -> API keys)
GRAPH_DEPLOY_KEY=         # subgraph studio deploy key

# RPCs (read-only public endpoints are fine for the enrichment service)
RPC_ETHEREUM=
RPC_BASE=
RPC_ARBITRUM=

# Gym (fork) - anvil forks one of the above; Tenderly is optional
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=

# Agents
# the gladiators' minds (agents/): a Claude API key; without it only GLADIATOR_MIND=heuristic runs
ANTHROPIC_API_KEY=
# GLADIATOR_MODEL=claude-opus-5   GLADIATOR_EFFORT=high   GLADIATOR_MIND=heuristic (control line)
# GENERATIONS=2   GEN_MINUTES=8   GLADIATORS=name:0xkey,...  (gym only; arena keys live in Ledger Key Ring)

# Arena (live) - gladiator keys are NOT env vars: they live in Ledger Key Ring (wallet-cli ring)
ARENA_CHAIN_ID=8453
BASESCAN_API_KEY=

# Aquascan enrichment
LLAMA_CALLS_PER_MINUTE=30
LLAMA_CALLS_PER_PASS=200
GRAPH_SUBGRAPH_ID_ETHEREUM=   # network id of the published Ethereum subgraph
GRAPH_SUBGRAPH_ID_BASE=       # network id of the published Base subgraph
GRAPH_SUBGRAPH_ID_ARBITRUM=   # network id of the published Arbitrum subgraph
GRAPH_SUBGRAPH_ID_OPTIMISM=   # network id of the published Optimism subgraph
GRAPH_SUBGRAPH_ID_POLYGON=   # network id of the published Polygon subgraph
GRAPH_SUBGRAPH_ID_BSC=   # network id of the published BSC subgraph
GRAPH_TOKEN_API_JWT=          # Token API bearer JWT from The Graph Market (prices, pool candles)
DEX_SUBGRAPH_ID_ETHEREUM=     # optional: a published DEX subgraph with the Uniswap v3 schema (defaults in aquascan/enrich/src/config.ts)
DEX_SUBGRAPH_ID_BSC=
DEX_SUBGRAPH_ID_BASE=6k7nx7L8JJu5bCuo6nQdiV7vn1uTxtXsBjUZy7XHzmNQ   # naumachy-pools-base on the network; a Studio query URL also works while a new version syncs
DEX_CALLS_PER_MINUTE=120

# Aquascan enrichment (aquascan/enrich)
AQUASCAN_DATABASE_URL=postgres://aquascan:aquascan@localhost:5433/aquascan
GATEWAY_CALLS_PER_MINUTE=30
ENRICH_POLL_SECONDS=300
AQUASCAN_API_PORT=3100
