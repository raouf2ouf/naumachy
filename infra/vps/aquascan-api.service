[Unit]
Description=Aquascan API (naumachy)
After=network-online.target docker.service
[Service]
User=naumachy
WorkingDirectory=/home/naumachy/naumachy
Environment=PATH=/home/naumachy/node-current/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/naumachy/node-current/bin/yarn workspace @naumachy/aquascan-api dev
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
