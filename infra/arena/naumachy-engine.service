[Unit]
Description=Naumachy taker engine on Base
After=network-online.target
Wants=network-online.target

[Service]
User=naumachy
WorkingDirectory=/home/naumachy/naumachy/arena
# the secrets are unsealed from the Ledger Key Ring into tmpfs first; nothing clear stays on disk
RuntimeDirectory=naumachy
RuntimeDirectoryPreserve=yes
ExecStartPre=/home/naumachy/naumachy/infra/arena/unseal.sh
EnvironmentFile=-/run/naumachy/arena.env
Environment=PATH=/home/naumachy/node-current/bin:/home/naumachy/.foundry/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c "set -a; . /run/naumachy/arena.env; exec /home/naumachy/node-current/bin/node --import tsx src/engine.ts"
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
