# The live arena on Base. Copied to /home/naumachy/arena.env on the host (mode 600), later sealed
# under the Ledger Key Ring and decrypted at boot. Keys are the six generated for Base, never the gym's.
ARENA_LIVE=1
GYM_RPC=https://base.gateway.tenderly.co/<key>
GYM_ADDRESSES=/home/naumachy/naumachy/infra/data/arena/addresses.json
GENERATIONS_DIR=/home/naumachy/naumachy/infra/data/arena/generations
GYM_RECORD=/home/naumachy/naumachy/agents/gym-record.json
SEED_FILE=/home/naumachy/naumachy/infra/arena/seed-from-gym.json
AQUASCAN_API=https://naumachy.xyz
# subgraphs on the network, through the gateway (the key sits in the URL, as the tape loader does)
GYM_SUBGRAPH=https://gateway.thegraph.com/api/<GRAPH_API_KEY>/subgraphs/id/<aqua base id>
ARENA_SUBGRAPH_URL=https://gateway.thegraph.com/api/<GRAPH_API_KEY>/subgraphs/id/<arena base id>
POOLS_SUBGRAPH_URL=https://gateway.thegraph.com/api/<GRAPH_API_KEY>/subgraphs/id/<pools base id>
# keys
LANISTA_KEY=0x...
ENGINE_KEY=0x...
GLADIATORS=steady:0x...,tight:0x...,wide:0x...,flat:0x...
GLADIATOR_KEYS=0x...,0x...,0x...,0x...
ARENA=0xb709161c34b032dd5c945e3418b20444b0f73bc6
ANTHROPIC_API_KEY=sk-ant-...
# ledgers: what each gladiator holds on Base, base units
GEN_LEDGER_WETH=7000000000000000
GEN_LEDGER_USDC=19000000
GEN_LEDGER_CBBTC=24000
LOOP_USDC=0.5
# seasons: about one generation an hour
GENERATIONS=1000
GEN_MINUTES=40
SCORE_WAIT_MINUTES=20
GLADIATOR_MODEL=claude-opus-5
GLADIATOR_EFFORT=high
# the engine's dials on real money: probes and orders well under RiskCap on an $18 ledger, a little uninformed flow, no tape
TICK_MS=4000
PROBE_USD=2
NOISE_USD=3
NOISE_PROBABILITY=0.05
EDGE_BPS=5
TOLERANCE_BPS=10
POOL_NOISE_PROBABILITY=0
INFORMED_PROBABILITY=0
