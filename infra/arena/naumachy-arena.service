[Unit]
Description=Naumachy arena: generations on Base (minds, lanista)
After=network-online.target naumachy-engine.service
Wants=network-online.target

[Service]
User=naumachy
WorkingDirectory=/home/naumachy/naumachy/agents
# the secrets are unsealed from the Ledger Key Ring into tmpfs first; nothing clear stays on disk
RuntimeDirectory=naumachy
RuntimeDirectoryPreserve=yes
ExecStartPre=/home/naumachy/naumachy/infra/arena/unseal.sh
EnvironmentFile=-/run/naumachy/arena.env
Environment=PATH=/home/naumachy/node-current/bin:/home/naumachy/.foundry/bin:/usr/local/bin:/usr/bin:/bin
Environment=ANVIL=/home/naumachy/.foundry/bin/anvil
ExecStart=/bin/bash -c "set -a; . /run/naumachy/arena.env; exec /home/naumachy/node-current/bin/node --import tsx src/evolve.ts"
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
