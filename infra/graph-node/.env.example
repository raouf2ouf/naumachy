# Copied to .env (ignored). The network name must match the subgraph manifest.
GRAPH_NETWORK=base
# An RPC that serves wide historical eth_getLogs ranges and eth_getBlockReceipts.
# Tenderly's Base gateway does both. Public endpoints ban a graph-node ingestor.
GRAPH_RPC=
# Largest block range graph-node may scan in one eth_getLogs call.
GRAPH_MAX_RANGE=100000
